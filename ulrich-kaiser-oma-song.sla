        <PAGEOBJECT XPOS="766.142362204725" YPOS="1216.14488188976" OwnPage="2" ItemID="1679065178" PTYPE="4" WIDTH="459.212705567961" HEIGHT="56.6929" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="0" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L459.213 0 L459.213 56.6929 L0 56.6929 L0 0 Z" copath="M0 0 L459.213 0 L459.213 56.6929 L0 56.6929 L0 0 Z" gXpos="-4.54747350886464e-13" gYpos="100.145173228343" gWidth="459.212705567961" gHeight="394.00029133858" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
