        <PageObject XPosition="766.142362204725" YPosition="1216.14488188976" OwnPage="2" ItemID="1787303356" ItemType="4" Width="459.212705567961" Height="56.6929" FrameType="0" ClipEdited="1" LineWidth="1" LinePenStyle="1" ImageScaleX="1" ImageScaleY="1" ImageOffsetX="0" ImageOffsetY="0" ImageRotation="0" ImageVisible="1" ImageScaleType="1" ImageRatio="1" Columns="1" ColumnGap="0" AutomaticTextFrame="0" TextToFrameDistanceLeft="0" TextToFrameDistanceTop="0" TextToFrameDistanceBottom="0" TextToFrameDistanceRight="0" VerticalAlignment="0" FirstLineOffset="0" PathTextShowPath="0" PathTextDistanceFromPath="0" TextPathType="0" TextPathFlipped="0" Path="M0 0 L459.213 0 L459.213 56.6929 L0 56.6929 L0 0 Z" ContourLinePath="M0 0 L459.213 0 L459.213 56.6929 L0 56.6929 L0 0 Z" gXpos="-9.09494701772928e-13" gYpos="100.145173228343" gWidth="459.212705567961" gHeight="394.00029133858" Layer="0" NextItem="-1" BackItem="-1">
